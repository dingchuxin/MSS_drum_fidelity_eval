# audio + large binaries — never commit
data/
*.wav
*.flac
*.mp3
*.aif
*.aiff
*.ogg
*.m4a
*.stem.mp4

# separated stems / model outputs
results/stems/
*.npy
*.npz

# python
.venv/
.venv-*/
venv/

# vendored external runners (cloned, not committed)
external/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# model weights / caches
models_cache/
# Spleeter auto-downloads its 4stems model into the repo root on first run
pretrained_models/
# cached separated stems (regenerated by run_benchmark)
data/stems_out/
*.th
*.ckpt
*.pth

# paper drafts — published separately on arXiv, cited from README
paper/

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# keep result tables + figures (small); ignore heavy intermediates
!results/tables/
!results/figures/
